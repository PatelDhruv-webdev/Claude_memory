{
  "name": "continuum-handoff",
  "version": "0.1.0",
  "description": "Automatic session-handoff daemon for AI coding agents — watches Claude Code and writes HANDOFF.md when your session ends",
  "type": "module",
  "bin": {
    "continuum": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "llm",
    "handoff",
    "session",
    "daemon",
    "codex",
    "cursor",
    "aider",
    "continuum",
    "context"
  ],
  "author": "Dhruv Patel <dhruv3415@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PatelDhruv-webdev/Claude_memory.git"
  },
  "homepage": "https://github.com/PatelDhruv-webdev/Claude_memory#readme",
  "bugs": {
    "url": "https://github.com/PatelDhruv-webdev/Claude_memory/issues"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm run build && pnpm run test"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "pino": "^9.5.0",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
